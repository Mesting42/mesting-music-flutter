--- /dev/null
+++ b/backend-java/src/test/java/com/auralink/backend/service/ExternalCosUpgradeContractTest.java
@@ -0,0 +1,101 @@
+package com.auralink.backend.service;
+
+import com.auralink.backend.entity.AppUpgradeRelease;
+import com.auralink.backend.dto.admin.CreateAppUpgradeDto;
+import com.auralink.backend.repository.AppUpgradeEventRepository;
+import com.auralink.backend.repository.AppUpgradeReleaseRepository;
+import com.auralink.backend.repository.AppUpgradeWhitelistRepository;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.Test;
+import java.net.http.HttpClient;
+import java.util.List;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+/** Public check payload remains usable with no hosted service or stored digest. */
+class ExternalCosUpgradeContractTest {
+    @Test void administratorCanCreateExternalCustomReleaseWithNoHealthOrHashes() {
+        var releases = mock(AppUpgradeReleaseRepository.class);
+        var whitelist = mock(AppUpgradeWhitelistRepository.class);
+        var offline = mock(HttpClient.class);
+        var resolver = new CustomApkDownloadSourceResolver(new ObjectMapper(),
+                "download.csnas.asia,download1.csnas.asia", 250, offline);
+        when(releases.findByPlatformOrderByVersionCodeDesc("ANDROID")).thenReturn(List.of());
+        when(releases.save(any(AppUpgradeRelease.class))).thenAnswer(i -> i.getArgument(0));
+        when(whitelist.findByReleaseId(any())).thenReturn(List.of());
+        var service = new AppUpgradeService(releases, whitelist,
+                mock(AppUpgradeEventRepository.class), null, null, resolver, null);
+        var dto = new CreateAppUpgradeDto();
+        dto.setPlatform("ANDROID"); dto.setVersionName("1.6.6"); dto.setVersionCode(8907);
+        dto.setReleaseNotes("Update"); dto.setStorageProvider("CUSTOM_URL");
+        dto.setCustomDownloadUrl("https://business.cos.example.com/LifeRing.apk");
+        dto.setRolloutMode("FULL");
+        var result = service.createRelease("admin", dto);
+        assertThat(result.get("apkFileSize")).isEqualTo(0L);
+        assertThat(result.get("apkSha256")).isEqualTo("");
+        assertThat(result.get("effectiveDownloadUrl")).isEqualTo(dto.getCustomDownloadUrl());
+        verifyNoInteractions(offline);
+    }
+
+    @Test void switchingHostedUrlToCosClearsStaleArtifactMetadataWithoutHealth() {
+        var releases = mock(AppUpgradeReleaseRepository.class);
+        var offline = mock(HttpClient.class);
+        var resolver = new CustomApkDownloadSourceResolver(new ObjectMapper(),
+                "download.csnas.asia,download1.csnas.asia", 250, offline);
+        var release = AppUpgradeRelease.builder().id("switch-release")
+                .platform("ANDROID").versionName("1.6.6").versionCode(8907)
+                .storageProvider("CUSTOM_URL")
+                .customDownloadUrl("https://download.csnas.asia/lifering/download")
+                .apkFileSize(131031231L).apkSha256("a".repeat(64))
+                .publishStatus("PUBLISHED").forceUpdate(false).rolloutMode("FULL").build();
+        when(releases.findById(release.getId())).thenReturn(java.util.Optional.of(release));
+        when(releases.save(release)).thenReturn(release);
+        when(releases.findByPlatformAndPublishStatusOrderByVersionCodeDesc("ANDROID", "PUBLISHED"))
+                .thenReturn(List.of(release));
+        var service = new AppUpgradeService(releases, mock(AppUpgradeWhitelistRepository.class),
+                mock(AppUpgradeEventRepository.class), null, null, resolver, null);
+        var url = "https://business.cos.example.com/LifeRing.apk?sign=private";
+        service.updateCustomDownloadUrl(release.getId(), url);
+        var result = service.checkUpgrade("ANDROID", 8906, "1.6.5", null, null);
+        assertThat(result.get("downloadUrl")).isEqualTo(url);
+        assertThat(result.get("fileSize")).isEqualTo(0L);
+        assertThat(result.get("sha256")).isEqualTo("");
+        assertThat(release.getPublishStatus()).isEqualTo("PUBLISHED");
+        assertThat(release.getVersionCode()).isEqualTo(8907);
+        verifyNoInteractions(offline);
+    }
+
+    @Test void customCosLinkWithoutMetadataPassesThroughTheActualCheckApiService() {
+        assertExternalCheck("CUSTOM_URL",
+                "https://release-123.cos.ap-guangzhou.myqcloud.com/LifeRing.apk?sign=private");
+    }
+
+    @Test void configuredCosCdnWithoutMetadataPassesThroughTheActualCheckApiService() {
+        assertExternalCheck("COS", "https://cdn.business.example.com/LifeRing.apk");
+    }
+
+    private void assertExternalCheck(String provider, String url) {
+        var releases = mock(AppUpgradeReleaseRepository.class);
+        var whitelist = mock(AppUpgradeWhitelistRepository.class);
+        var events = mock(AppUpgradeEventRepository.class);
+        var offline = mock(HttpClient.class);
+        var resolver = new CustomApkDownloadSourceResolver(new ObjectMapper(),
+                "download.csnas.asia,download1.csnas.asia", 250, offline);
+        var release = AppUpgradeRelease.builder().id("cos-release")
+                .platform("ANDROID").versionName("1.6.6").versionCode(8907)
+                .storageProvider(provider).customDownloadUrl(url).publicDownloadUrl(url)
+                .apkFileSize(0L).apkSha256("").publishStatus("PUBLISHED")
+                .forceUpdate(false).rolloutMode("FULL").build();
+        when(releases.findByPlatformAndPublishStatusOrderByVersionCodeDesc("ANDROID", "PUBLISHED"))
+                .thenReturn(List.of(release));
+        var service = new AppUpgradeService(releases, whitelist, events,
+                null, null, resolver, null);
+        var result = service.checkUpgrade("ANDROID", 8906, "1.6.5", null, null);
+        assertThat(result.get("hasUpdate")).isEqualTo(true);
+        assertThat(result.get("downloadUrl")).isEqualTo(url);
+        assertThat(result.get("fileSize")).isEqualTo(0L);
+        assertThat(result.get("sha256")).isEqualTo("");
+        assertThat(result).doesNotContainKeys("downloadProtocol", "downloadBackupUrl");
+        verifyNoInteractions(offline);
+    }
+}
